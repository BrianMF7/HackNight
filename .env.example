# Bearer secret the clinical server expects. Connection settings send it as Authorization: Bearer.
BACKEND_TOKEN=

# Port for `node server/index.js`. The connection dialog uses http://localhost:8787.
PORT=8787

# Browser origins allowed to read responses (comma-separated). Vite may bump the port.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ElevenLabs (Task 11): realtime speech-to-text (Scribe). Key stays on the server;
# the browser receives a short-lived single-use token only.
# https://elevenlabs.io/app/settings/api-keys — never commit a real value.
ELEVENLABS_API_KEY=

# Gemini. Live drafts call gemini-3.8-flash. Synthetic drafts load the recorded fixture and do not call this.
GEMINI_API_KEY=

# Set to 1 before a non-synthetic transcript may be sent to Gemini. Unset refuses before any request.
ALLOW_PHI=
