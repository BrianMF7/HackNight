# Bearer secret the clinical server expects. Connection settings send it as Authorization: Bearer.
BACKEND_TOKEN=hacknight-demo

# Port for `node server/index.js`. The connection dialog uses http://localhost:8787.
PORT=8787

# Vite defaults for Connection settings (browser). Must match BACKEND_TOKEN and PORT above.
VITE_BACKEND_URL=http://localhost:8787
VITE_BACKEND_TOKEN=hacknight-demo

# Browser origins allowed to read responses (comma-separated). Vite may bump the port.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ElevenLabs (Task 11): realtime speech-to-text (Scribe). Key stays on the server;
# the browser receives a short-lived single-use token only.
# https://elevenlabs.io/app/settings/api-keys — never commit a real value.
ELEVENLABS_API_KEY=

# Daily (Task 13): one private video room per live session. Key stays on the server;
# the browser receives only the room URL and an owner token.
# https://dashboard.daily.co/developers — never commit a real value.
DAILY_API_KEY=

# Gemini. Live drafts call gemini-3.8-flash. Synthetic drafts load the recorded fixture and do not call this.
GEMINI_API_KEY=

# Set to 1 before a non-synthetic transcript may be sent to Gemini. Unset refuses before any request.
ALLOW_PHI=

# Tiger Cloud / TimescaleDB. Clinical server uses this for GET /api/db/ping and Task 12 store.
# Missing DATABASE_URL skips DB work; handoff PDF/email can still succeed.
DATABASE_URL=
